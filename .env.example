# Copy this file to .env and fill it in. Never commit .env.

# Owner account. Created on the first start, when no accounts exist yet.
# After that, change your password inside the dashboard (Team → Your account). These values are then ignored.
OWNER_EMAIL=you@example.com
OWNER_NAME=Kulwant
DASHBOARD_PASSWORD=change-me-to-something-long

# Recommended. Signs the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Public address of the site, used to build invite links (e.g. https://dashboard.yourdomain.com).
# Leave empty to use whatever address the request came in on.
BASE_URL=

# Optional. Port to listen on (most hosts set this for you).
PORT=3000

# Optional. Postgres connection string. Leave empty to store data in JSON files instead.
# Neon example: postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional. Folder for the JSON files when DATABASE_URL is empty. Defaults to ./data
DATA_DIR=

# Optional. Postgres TLS: verify (default), disable (local DB), no-verify (self-signed cert only)
PGSSL=
